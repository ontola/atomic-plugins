{
  "name": "syncables",
  "version": "0.25.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ontola/atomic-plugins.git",
    "directory": "syncables"
  },
  "description": "Reads an OpenAPI document to run a mock API server and a client that syncs a local copy of the API's dataset.",
  "type": "module",
  "main": "build/src/index.js",
  "types": "build/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/src/index.d.ts",
      "default": "./build/src/index.js"
    },
    "./browser": {
      "types": "./build/src/browser.d.ts",
      "default": "./build/src/browser.js"
    },
    "./postgres": {
      "types": "./build/src/postgres/index.d.ts",
      "default": "./build/src/postgres/index.js"
    },
    "./daemon": {
      "types": "./build/src/daemon/index.d.ts",
      "default": "./build/src/daemon/index.js"
    }
  },
  "files": [
    "build/src"
  ],
  "engines": {
    "node": ">= 22.11"
  },
  "devDependencies": {
    "@eslint/js": "~9.17",
    "@types/eslint__js": "~8.42",
    "@types/js-yaml": "~4.0",
    "@types/node": "~20",
    "@types/pg": "8.23.1",
    "@typescript-eslint/parser": "~8.19",
    "@vitest/coverage-v8": "~2.1",
    "@vitest/eslint-plugin": "~1.1",
    "esbuild": "~0.21.5",
    "eslint": "~9.17",
    "eslint-config-prettier": "~9.1",
    "globals": "~15.14",
    "prettier": "~3.4",
    "rimraf": "~6.0",
    "ts-api-utils": "~2.0",
    "typescript": "~5.7",
    "typescript-eslint": "~8.19",
    "vitest": "~2.1"
  },
  "scripts": {
    "clean": "rimraf coverage build tmp",
    "prebuild": "npm run lint",
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -w -p tsconfig.json",
    "build:release": "npm run clean && tsc -p tsconfig.release.json",
    "lint": "eslint .",
    "test": "vitest run unit --config __tests__/vitest.config.ts",
    "test:coverage": "vitest run unit --config __tests__/vitest.config.ts --coverage.enabled --coverage.all",
    "prettier": "prettier \"{src,__tests__}/**/*.{ts,mts}\" scripts/changelog.mjs --config .prettierrc --write",
    "prettier:check": "prettier \"{src,__tests__}/**/*.{ts,mts}\" scripts/changelog.mjs --config .prettierrc --check",
    "test:watch": "vitest unit",
    "changelog": "node scripts/changelog.mjs",
    "prepare": "npm run build:release",
    "cli:mock": "node examples/cli-device-server.mjs"
  },
  "author": "Michiel de Jong <michiel@unhosted.org>",
  "license": "Apache-2.0",
  "dependencies": {
    "@bokuweb/zstd-wasm": "0.0.27",
    "braid-http": "1.4.10",
    "js-yaml": "~4.1",
    "pg": "8.23.1",
    "tslib": "~2.8"
  },
  "volta": {
    "node": "22.12.0"
  },
  "bin": {
    "syncables": "build/src/cli/main.js"
  }
}
