            "type": "string"
          }
        },
        "type": "object"
      },
      "User": {
        "description": "Describes a single user.",
        "properties": {
          "email": {
            "description": "The user's email.",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "Oauth2": {
        "description": "Oauth 2.0 implicit authentication",
        "flows": {
          "implicit": {
            "authorizationUrl": "https://accounts.google.com/o/oauth2/auth",
            "scopes": {
              "https://www.googleapis.com/auth/keep": "See, edit, create and permanently delete all your Google Keep data",
              "https://www.googleapis.com/auth/keep.readonly": "View all your Google Keep data"
            }
          }
        },
        "type": "oauth2"
      },
      "Oauth2c": {
        "description": "Oauth 2.0 accessCode authentication",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://accounts.google.com/o/oauth2/auth",
            "scopes": {
              "https://www.googleapis.com/auth/keep": "See, edit, create and permanently delete all your Google Keep data",
              "https://www.googleapis.com/auth/keep.readonly": "View all your Google Keep data"
            },
            "tokenUrl": "https://accounts.google.com/o/oauth2/token"
          }
        },
        "type": "oauth2"
      },
      "googleKeepOAuth": {
        "type": "oauth2",
        "x-oauth-authentication-details": {
          "authorizationServerMetadata": {
            "token_endpoint_auth_methods_supported": [
              "client_secret_post",
              "client_secret_basic"
            ],
            "code_challenge_methods_supported": [
              "S256"
            ]
          },
          "authorizationCode": {
            "pkce": {
              "requirement": "optional"
            },
            "profile": {
              "parameters": [
                {
                  "parameter": {
                    "name": "access_type",
                    "in": "query",
                    "schema": {
                      "type": "string",
                      "enum": [
                        "offline"
                      ]
                    }
                  },
                  "value": "offline"
                }
              ]
            },
            "capabilities": [
              "offlineAccess"
            ],
            "tokenIssuance": {
              "refreshToken": {
                "presence": "conditional",
                "conditions": [
                  "firstAuthorization"
                ],
                "description": "Google can omit a refresh token after the first authorization."
              }
            }
          }
        },
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://accounts.google.com/o/oauth2/v2/auth",
            "tokenUrl": "https://oauth2.googleapis.com/token",
            "scopes": {
              "https://www.googleapis.com/auth/keep": "See, edit, create and permanently delete all your Google Keep data."
            }
          }
        }
      }
    },
    "x-authentication-profiles": {
      "googleKeep": {
        "securityScheme": "googleKeepOAuth",
        "description": "List, read, create and delete the connected person's Google Keep notes."
      }
    },
    "paginationSchemes": {
      "forwardPages": {
        "type": "pageToken",
        "autoDetect": false,
        "description": "Send nextPageToken as pageToken until the token is absent or empty, including after a short or empty page. Keep filters and page size fixed. Zero pageSize lets Google choose the upper bound. An ABORTED response is a failed reconciliation, not successful completion.",
        "request": {
          "queryParameters": {
            "pageToken": {
              "role": "cursor"
            },
            "pageSize": {
              "role": "pageSize"
            }
          }
        },
        "response": {
          "bodyFields": {
            "nextPageToken": {
              "role": "nextCursor"
            }
          },
          "envelope": {
            "itemsField": "notes",
            "emptyWhenAbsent": true
          }
        }
      }
    },
    "crudResources": {
      "note": {
        "schema": {
          "$ref": "#/components/schemas/Note"
        },
        "identity": {
          "urlTemplate": "/v1/{name}",
          "bindings": {
            "name": {
              "field": "name",
              "x-path-segments": true
            }
          }
        },
        "collections": {
          "notes": {
            "urlTemplate": "/v1/notes",
            "envelope": {
              "itemsField": "notes",
              "emptyWhenAbsent": true
            }
          }
        },
        "replace": {
          "description": "Keep has no note update operation. Create the replacement, durably record its new resource name, then permanently delete the old note. Replacements lose colour, labels, pins, reminders and Keep ordering. Only the owner can delete a note; clients must verify ownership.",
          "blockedBy": [
            {
              "field": "attachments",
              "when": "nonEmpty",
              "description": "The API cannot copy attachments into a replacement note."
            },
            {
              "field": "permissions",
              "moreThan": 1,
              "except": {
                "deleted": true
              },
              "description": "A replacement note would lose its collaborators."
            }
          ]
        },
        "unkeyedLists": {
          "body.list.listItems": {
            "match": [
              "text.text",
              "checked"
            ],
            "children": "childListItems"
          }
        }
      }
    }
  }
}
