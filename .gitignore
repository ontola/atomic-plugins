/browser
/artifacts
*.log
*.pid
node_modules
/integrations/tooling/playwright-report
/integrations/tooling/test-results
playwright-report/
/integrations/*/app/dist
usertest/out/
# Local Claude Code state stays out; the shared settings, the cloud-session
# hook and the repo's skills are tracked.
/.claude/*
!/.claude/settings.json
!/.claude/hooks/
!/.claude/skills/
# Default `npm init -y` output and its empty pnpm lockfile, which a stray
# `npm init` / `pnpm add` run from integrations/ leaves behind. integrations/
# is not a package (each plugin folder has its own), and nothing reads these.
/integrations/package.json
/integrations/pnpm-lock.yaml
