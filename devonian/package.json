{
  "name": "devonian",
  "version": "0.8.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ontola/atomic-plugins.git",
    "directory": "devonian"
  },
  "description": "Bidirectional Lenses for Data Portability",
  "type": "module",
  "engines": {
    "node": ">= 22.11 < 23"
  },
  "exports": {
    ".": {
      "types": "./build/src/main.d.ts",
      "default": "./build/src/main.js"
    },
    "./atomic": {
      "types": "./build/src/atomic/index.d.ts",
      "default": "./build/src/atomic/index.js"
    },
    "./background": {
      "types": "./build/src/background/index.d.ts",
      "default": "./build/src/background/index.js"
    },
    "./reflect": {
      "types": "./build/src/reflect/index.d.ts",
      "browser": "./build/src/reflect/browser.js",
      "default": "./build/src/reflect/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "docs",
    "build",
    "vocab",
    "src"
  ],
  "devDependencies": {
    "@automerge/automerge-repo-network-broadcastchannel": "^2.0.0",
    "@automerge/automerge-repo-storage-nodefs": "^2.0.0",
    "@eslint/js": "~9.17",
    "@types/eslint__js": "~8.42",
    "@types/node": "~20",
    "@tomic/lib": "^0.40.0",
    "@typescript-eslint/parser": "~8.19",
    "@vitest/coverage-v8": "^3.0.8",
    "@vitest/eslint-plugin": "~1.1",
    "esbuild": "^0.25.4",
    "eslint": "~9.17",
    "eslint-config-prettier": "~9.1",
    "globals": "~15.14",
    "prettier": "~3.4",
    "rimraf": "~6.0",
    "syncables": "^0.17.1",
    "ts-api-utils": "~2.0",
    "typedoc": "^0.28.4",
    "typescript": "~5.7",
    "typescript-eslint": "~8.19",
    "vitest": "^3.0.8"
  },
  "scripts": {
    "start": "node build/src/main.js",
    "clean": "rimraf coverage build tmp",
    "prebuild": "npm run lint",
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run clean && npm run build",
    "build:watch": "tsc -w -p tsconfig.json",
    "build:release": "npm run clean && tsc -p tsconfig.release.json",
    "lint": "eslint . --ignore-pattern 'docs/*' ",
    "test": "vitest run --config __tests__/vitest.config.ts",
    "test:unit": "vitest run unit --config __tests__/vitest.config.ts",
    "test:examples": "vitest run examples --config __tests__/vitest.config.ts",
    "test:browser-build": "DEVONIAN_TEST_BUILD=1 vitest run browser --config __tests__/vitest.config.ts",
    "test:coverage": "vitest run --config __tests__/vitest.config.ts --coverage.enabled --coverage.all",
    "prettier": "prettier \"{src,__{tests}__}/**/*.{ts,mts}\" --config .prettierrc --write",
    "prettier:check": "prettier \"{src,__{tests}__}/**/*.{ts,mts}\" --config .prettierrc --check",
    "test:watch": "vitest"
  },
  "author": "Michiel de Jong <michiel@unhosted.org>",
  "license": "Apache-2.0",
  "dependencies": {
    "@automerge/automerge-repo": "^2.0.0",
    "fast-json-stable-stringify": "^2.1.0",
    "effect": "^3.16.0",
    "tslib": "~2.8"
  },
  "peerDependencies": {
    "@tomic/lib": ">=0.40.0",
    "syncables": ">=0.17.0"
  },
  "peerDependenciesMeta": {
    "@tomic/lib": {
      "optional": true
    },
    "syncables": {
      "optional": true
    }
  },
  "volta": {
    "node": "22.12.0"
  }
}
