# Caddy config for the user-testing server (claude-build). Installed as
# /etc/caddy/Caddyfile by deploy.sh; Caddy fetches the Let's Encrypt
# certificates itself. BASE_DOMAIN and ACME_EMAIL come from
# /etc/caddy/usertest.env, which the systemd drop-in caddy-usertest.conf
# loads (see README.md).
{
	email {$ACME_EMAIL}
	# Certificates for plugin-route hosts are fetched on the first TLS
	# handshake (see *.routes below), but only for a host the ask endpoint
	# answers 200 for.
	on_demand_tls {
		ask http://127.0.0.1:8083/routes-host
	}
}

# atomic-server (server.sh), plain HTTP on loopback. It builds its links from
# ATOMIC_DOMAIN and reads the scheme from X-Forwarded-Proto, which Caddy sets.
# /usertest/ is the moderated-session page (page/) and /usertest/api/ its
# moderator (moderator/). They share the data-browser's origin so the page can
# set the test catalog in the browser's storage.
plugins.{$BASE_DOMAIN} {
	redir /usertest /usertest/?{query} 308
	handle_path /usertest/api/* {
		reverse_proxy 127.0.0.1:8082
	}
	handle_path /usertest/* {
		root * /opt/usertest/page
		header Cache-Control "no-cache"
		file_server
	}
	handle {
		reverse_proxy 127.0.0.1:8080
	}
}

# The test catalog, the drive app modules it points at and the sample files
# for sessions (catalog.mjs).
# The data-browser fetches the catalog cross-origin; app modules are
# downloaded by the host and checked against their SRI hash.
catalog.{$BASE_DOMAIN} {
	root * /srv/catalog
	header Access-Control-Allow-Origin *
	header Cache-Control "no-cache"
	# Sample files for sessions (moderator/sessions/*.md): a download, not a
	# page, whatever the browser makes of .mt940 or .xml.
	header /samples/* Content-Disposition attachment
	file_server
}

# The log collector (collector/server.mjs): Sentry envelopes from
# atomic-server and the data-browser, and /log posts from drive apps.
logs.{$BASE_DOMAIN} {
	reverse_proxy 127.0.0.1:8081
}

# Server plugins' installation origins, https://<slug>.routes.<base-domain>
# (server.sh with USERTEST_PLUGIN_ROUTES). atomic-server picks the
# Installation by the Host header, which reverse_proxy passes on unchanged.
# Caddy has no wildcard certificate for them, so each host gets its own, on
# demand. With plugin routes off, atomic-server serves nothing on these hosts.
*.routes.{$BASE_DOMAIN} {
	tls {
		on_demand
	}
	reverse_proxy 127.0.0.1:8080
}

# The on_demand_tls ask endpoint, on loopback only. A host is allowed when it
# is <32 hex>.routes.<something> and a file of that name exists in
# /etc/caddy/routes-allowed/ (README.md, "Trying server plugins"). The
# allowlist keeps anyone from making Caddy request certificates for made-up
# slugs and using up the Let's Encrypt rate limits the other hosts share.
http://127.0.0.1:8083 {
	bind 127.0.0.1
	@allowed {
		path /routes-host
		expression `{query.domain}.matches("^[0-9a-f]{32}\\.routes\\.[a-z0-9.-]+$")`
		file {
			root /etc/caddy/routes-allowed
			try_files /{query.domain}
		}
	}
	respond @allowed 200
	respond 404
}
