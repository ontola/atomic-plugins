{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ontola.github.io/atomic-plugins/openapi-extensions/spec/pagination-schemes/schema.json",
  "title": "Pagination Schemes 0.5.0",
  "description": "A Pagination Scheme Object (§4.1). $defs.application is the Pagination Application Object (§5), $defs.linkResolution the Link Resolution Object (§4.4.3), $defs.window the Range Window Object (§4.6.1). Covers validation rules 1-4, 8-10 and 12-16; validate.py adds 5, 11, 17 and 18.",
  "$ref": "#/$defs/scheme",
  "$defs": {
    "scheme": {
      "type": "object",
      "required": ["type"],
      "anyOf": [{ "required": ["request"] }, { "required": ["response"] }],
      "properties": {
        "type": { "enum": ["pageNumber", "pageToken", "nextLink", "incrementalSync", "rangeWindow"] },
        "description": { "type": "string" },
        "autoDetect": {
          "oneOf": [{ "type": "boolean" }, { "$ref": "#/$defs/autoDetect" }]
        },
        "window": { "$ref": "#/$defs/window" },
        "request": { "$ref": "#/$defs/request" },
        "response": { "$ref": "#/$defs/response" }
      },
      "patternProperties": { "^x-": true },
      "additionalProperties": false,
      "if": { "required": ["type"], "properties": { "type": { "const": "rangeWindow" } } },
      "then": {
        "description": "Rules 12, 14 (window fields counted by validate.py) and 16.",
        "required": ["window", "request"],
        "properties": { "autoDetect": { "const": false } }
      },
      "else": {
        "description": "Rules 12 and 14: no window, and no window role, outside a rangeWindow scheme.",
        "not": { "required": ["window"] },
        "properties": { "request": { "$ref": "#/$defs/pagedRequest" } }
      }
    },
    "pagedRequest": {
      "type": "object",
      "properties": {
        "queryParameters": { "$ref": "#/$defs/pagedFields" },
        "bodyFields": { "$ref": "#/$defs/pagedFields" },
        "headerFields": { "$ref": "#/$defs/pagedFields" }
      }
    },
    "pagedFields": {
      "type": "object",
      "additionalProperties": {
        "not": {
          "required": ["role"],
          "properties": { "role": { "enum": ["windowStart", "windowEnd", "windowRange"] } }
        }
      }
    },
    "window": {
      "type": "object",
      "required": ["unit", "format", "bounds", "cap"],
      "properties": {
        "unit": { "enum": ["day", "second", "integer"] },
        "format": { "enum": ["date", "basicDate", "dateTime", "unixSeconds", "integer"] },
        "bounds": { "enum": ["closed", "halfOpen"] },
        "cap": { "type": "integer", "minimum": 1 },
        "minimumWidth": { "type": "integer", "minimum": 1 },
        "field": { "type": "string", "pattern": "^(/([^~]|~[01])*)*$" },
        "timeZone": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      },
      "patternProperties": { "^x-": true },
      "additionalProperties": false,
      "allOf": [
        {
          "description": "Rule 13: format fits unit.",
          "if": { "required": ["unit"], "properties": { "unit": { "const": "day" } } },
          "then": { "properties": { "format": { "enum": ["date", "basicDate"] } } }
        },
        {
          "if": { "required": ["unit"], "properties": { "unit": { "const": "second" } } },
          "then": { "properties": { "format": { "enum": ["dateTime", "unixSeconds"] } } }
        },
        {
          "if": { "required": ["unit"], "properties": { "unit": { "const": "integer" } } },
          "then": { "properties": { "format": { "const": "integer" } } }
        },
        {
          "description": "Rule 12: timeZone only with unit day.",
          "if": { "required": ["unit"], "properties": { "unit": { "const": "day" } } },
          "else": { "not": { "required": ["timeZone"] } }
        }
      ]
    },
    "application": {
      "type": "object",
      "required": ["scheme"],
      "properties": {
        "scheme": { "type": "string", "minLength": 1 },
        "overrides": {
          "description": "Any part of a scheme, deep-merged onto the referenced one (§5). validate.py checks the merged scheme against #/$defs/scheme.",
          "type": "object"
        },
        "description": { "type": "string" }
      },
      "patternProperties": { "^x-": true },
      "additionalProperties": false
    },
    "autoDetect": {
      "type": "object",
      "properties": {
        "matchQueryParams": { "type": "boolean" },
        "matchBodyFields": { "type": "boolean" },
        "matchResponseFields": { "type": "boolean" },
        "matchHeaders": { "type": "boolean" },
        "requireAll": { "type": "boolean" }
      },
      "patternProperties": { "^x-": true },
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "properties": {
        "queryParameters": { "$ref": "#/$defs/requestFields" },
        "bodyFields": { "$ref": "#/$defs/requestFields" },
        "headerFields": { "$ref": "#/$defs/requestFields" }
      },
      "patternProperties": { "^x-": true },
      "additionalProperties": false
    },
    "requestFields": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/requestField" }
    },
    "requestField": {
      "type": "object",
      "properties": {
        "description": { "type": "string" },
        "schema": { "type": "object" },
        "role": {
          "anyOf": [
            {
              "enum": [
                "page",
                "pageSize",
                "offset",
                "pageToken",
                "cursor",
                "previousPageToken",
                "syncToken",
                "windowStart",
                "windowEnd",
                "windowRange"
              ]
            },
            { "type": "string", "pattern": "^x-" }
          ]
        },
        "required": { "type": "boolean" },
        "template": {
          "description": "Rule 15: {start} and {end} once each, no other braces.",
          "type": "string",
          "pattern": "^(?:[^{}]*\\{start\\}[^{}]*\\{end\\}[^{}]*|[^{}]*\\{end\\}[^{}]*\\{start\\}[^{}]*)$"
        }
      },
      "patternProperties": { "^x-": true },
      "additionalProperties": false,
      "if": { "required": ["role"], "properties": { "role": { "const": "windowRange" } } },
      "then": { "required": ["template"] },
      "else": { "not": { "required": ["template"] } }
    },
    "response": {
      "type": "object",
      "properties": {
        "envelope": { "$ref": "#/$defs/envelope" },
        "bodyFields": { "$ref": "#/$defs/responseFields" },
        "headers": { "$ref": "#/$defs/responseFields" }
      },
      "patternProperties": { "^x-": true },
      "additionalProperties": false
    },
    "envelope": {
      "type": "object",
      "properties": {
        "itemsField": { "type": ["string", "null"] }
      },
      "patternProperties": { "^x-": true },
      "additionalProperties": false
    },
    "responseFields": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/responseField" }
    },
    "responseField": {
      "type": "object",
      "properties": {
        "description": { "type": "string" },
        "schema": { "type": "object" },
        "role": {
          "anyOf": [
            {
              "enum": [
                "nextPageToken",
                "nextCursor",
                "nextLink",
                "previousPageToken",
                "previousLink",
                "nextSyncToken",
                "totalCount",
                "totalPages",
                "pageSize",
                "currentPage",
                "offset"
              ]
            },
            { "type": "string", "pattern": "^x-" }
          ]
        },
        "linkResolution": { "$ref": "#/$defs/linkResolution" }
      },
      "patternProperties": { "^x-": true },
      "additionalProperties": false,
      "if": { "required": ["linkResolution"] },
      "then": {
        "required": ["role"],
        "properties": { "role": { "enum": ["nextLink", "previousLink"] } }
      }
    },
    "linkResolution": {
      "type": "object",
      "required": ["base"],
      "properties": {
        "base": { "enum": ["request", "server", "declared"] },
        "url": {
          "type": "string",
          "pattern": "^https?://[^/?#@\\s\\\\]+(?:[/?][^#\\s\\\\]*)?$"
        },
        "description": { "type": "string" }
      },
      "patternProperties": { "^x-": true },
      "additionalProperties": false,
      "if": { "properties": { "base": { "const": "declared" } } },
      "then": { "required": ["url"] },
      "else": { "not": { "required": ["url"] } }
    }
  }
}
