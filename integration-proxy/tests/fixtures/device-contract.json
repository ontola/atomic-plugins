{
  "contract_version": 1,
  "public_client": { "client_id": "syncables-cli", "name": "Syncables CLI", "registration": "operator configuration", "client_secret": false },
  "discovery_path": "/.well-known/oauth-authorization-server",
  "device_authorization_path": "/oauth/device/code",
  "token_path": "/oauth/device/token",
  "revocation_path": "/oauth/device/revoke",
  "verification_path": "/device",
  "challenge_path": "/device/challenge",
  "approval_path": "/device/approve",
  "request_encoding": "application/x-www-form-urlencoded",
  "approval_encoding": "application/json",
  "approval_authentication": "existing owner Atomic v2 request signatures",
  "grant_types": ["urn:ietf:params:oauth:grant-type:device_code", "refresh_token"],
  "scopes": ["connections:read", "proxy:read", "proxy:write"],
  "reserved_unavailable_scope": "proxy:write",
  "device_response_fields": ["device_code", "user_code", "verification_uri", "verification_uri_complete", "expires_in", "interval"],
  "token_response_fields": ["access_token", "token_type", "expires_in", "refresh_token", "scope", "owner", "client_id", "session_id"],
  "poll_errors": ["authorization_pending", "slow_down", "access_denied", "expired_token", "invalid_grant"],
  "device_expires_in": 600,
  "initial_poll_interval": 5,
  "slow_down_increment": 5,
  "access_expires_in": 600,
  "session_max_lifetime_days": 30,
  "resource_authentication": "Bearer",
  "discovery_response_fields": ["owner", "client_id", "session_id", "connections"],
  "connection_response_fields": ["connection_id", "platform", "owner", "label"],
  "write_methods": ["POST", "PUT", "PATCH", "DELETE"],
  "read_methods": ["GET", "HEAD"],
  "refresh_reuse": "revoke entire session, including winner of concurrent refresh",
  "revocation": "idempotent HTTP 200, entire individual session"
}
