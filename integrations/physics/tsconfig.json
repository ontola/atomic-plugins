{
  "extends": "../../browser/tsconfig.build.json",
  "compilerOptions": {
    "rootDir": "../..",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM"],
    "typeRoots": ["../../browser/node_modules/@types"],
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "core/*.ts",
    "shared/*.ts",
    "shared/*.d.mts",
    "lens/*.ts",
    "magnet/*.ts",
    "spring/*.ts",
    "../sync-status/css.d.ts"
  ],
  "exclude": [
    "core/*.test.ts",
    "shared/*.test.ts",
    "shared/testing.ts",
    "lens/*.test.ts",
    "magnet/*.test.ts",
    "spring/*.test.ts"
  ]
}
