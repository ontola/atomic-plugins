{
  "extends": "../../browser/tsconfig.build.json",
  "compilerOptions": {
    "rootDir": "../..",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "typeRoots": ["../../browser/node_modules/@types"],
    "types": ["node"],
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@tomic/lib": ["../../browser/lib/src/index.ts"]
    }
  },
  "include": ["adapter.ts", "app/*.ts", "app/ui/*.ts", "devonian/**/*.ts"],
  "exclude": [
    "app/*.test.ts",
    "app/ui/*.test.ts",
    "app/fakeStore.ts",
    "devonian/**/*.test.ts"
  ]
}
