{
  "//": "Startboom wiskunde en natuurkunde voor de app Atomic Education. Sleutels (key) zijn lokaal; bij laden worden ze Skill-rijen in de tabel. Lessen hebben nog geen echt materiaal: elk `content` is een TODO (alleen opnemen als de bron zeker stabiel en publiek is). Geen em-streepjes in de Nederlandse tekst.",
  "name": "Wiskunde en natuurkunde",
  "language": "nl",
  "skills": [
    {
      "key": "rekenen",
      "name": "Rekenen met getallen",
      "description": "Je kunt optellen, aftrekken, vermenigvuldigen en delen met hele getallen en kommagetallen, en je kent de rekenvolgorde.",
      "requires": [],
      "recommends": []
    },
    {
      "key": "breuken",
      "name": "Breuken",
      "description": "Je kunt breuken vereenvoudigen, vergelijken en ermee rekenen, en breuken omzetten naar kommagetallen.",
      "requires": ["rekenen"],
      "recommends": []
    },
    {
      "key": "procenten",
      "name": "Procenten en verhoudingen",
      "description": "Je kunt procenten, verhoudingen en evenredigheid gebruiken om een deel, een toename of een afname uit te rekenen.",
      "requires": ["breuken"],
      "recommends": []
    },
    {
      "key": "machten-wortels",
      "name": "Machten en wortels",
      "description": "Je kunt rekenen met kwadraten, machten en wortels en schrijven in wetenschappelijke notatie.",
      "requires": ["rekenen"],
      "recommends": []
    },
    {
      "key": "algebra-basis",
      "name": "Algebra: rekenen met letters",
      "description": "Je kunt met letters in plaats van getallen rekenen: haakjes wegwerken, termen samenvatten en een formule herschrijven.",
      "requires": ["rekenen"],
      "recommends": ["breuken", "machten-wortels"]
    },
    {
      "key": "vergelijkingen",
      "name": "Vergelijkingen oplossen",
      "description": "Je kunt lineaire en kwadratische vergelijkingen en stelsels van twee vergelijkingen oplossen.",
      "requires": ["algebra-basis"],
      "recommends": []
    },
    {
      "key": "functies",
      "name": "Functies en grafieken",
      "description": "Je kunt een formule als functie lezen, een grafiek tekenen en nulpunten, snijpunten en stijging aflezen.",
      "requires": ["vergelijkingen"],
      "recommends": []
    },
    {
      "key": "meetkunde",
      "name": "Meetkunde",
      "description": "Je kunt hoeken, omtrek, oppervlakte en inhoud berekenen en de stelling van Pythagoras en gelijkvormigheid gebruiken.",
      "requires": ["rekenen"],
      "recommends": ["breuken"]
    },
    {
      "key": "trigonometrie",
      "name": "Trigonometrie",
      "description": "Je kunt sinus, cosinus en tangens gebruiken om zijden en hoeken van driehoeken te berekenen en je kent de eenheidscirkel.",
      "requires": ["meetkunde", "vergelijkingen"],
      "recommends": []
    },
    {
      "key": "exponenten-logaritmen",
      "name": "Exponentiële functies en logaritmen",
      "description": "Je kunt exponentiële groei en afname beschrijven en logaritmen gebruiken om een exponent op te lossen.",
      "requires": ["functies", "machten-wortels"],
      "recommends": []
    },
    {
      "key": "afgeleiden",
      "name": "Afgeleiden",
      "description": "Je begrijpt de afgeleide als verandersnelheid en kunt de afgeleide van veelvoorkomende functies bepalen en gebruiken voor extremen.",
      "requires": ["functies"],
      "recommends": ["trigonometrie", "exponenten-logaritmen"]
    },
    {
      "key": "integralen",
      "name": "Integralen",
      "description": "Je begrijpt de integraal als oppervlakte onder een grafiek en als omgekeerde van de afgeleide, en kunt eenvoudige integralen berekenen.",
      "requires": ["afgeleiden"],
      "recommends": []
    },
    {
      "key": "vectoren",
      "name": "Vectoren",
      "description": "Je kunt vectoren optellen, ontbinden in componenten en de lengte en richting ervan bepalen.",
      "requires": ["trigonometrie"],
      "recommends": []
    },
    {
      "key": "lineaire-algebra",
      "name": "Lineaire algebra: basis",
      "description": "Je kunt rekenen met matrices, het inproduct gebruiken en een stelsel lineaire vergelijkingen met matrices oplossen.",
      "requires": ["vectoren", "vergelijkingen"],
      "recommends": []
    },
    {
      "key": "kans-statistiek",
      "name": "Kansrekening en statistiek",
      "description": "Je kunt kansen berekenen, gemiddelde, mediaan en standaardafwijking bepalen en een normale verdeling lezen.",
      "requires": ["procenten"],
      "recommends": ["algebra-basis"]
    },
    {
      "key": "eenheden-meten",
      "name": "Eenheden en meten",
      "description": "Je kunt SI-eenheden omrekenen, voorvoegsels gebruiken, significante cijfers hanteren en de onzekerheid van een meting noemen.",
      "requires": ["rekenen"],
      "recommends": ["procenten", "machten-wortels"]
    },
    {
      "key": "kinematica",
      "name": "Beweging: snelheid en versnelling",
      "description": "Je kunt beweging met constante snelheid en versnelling beschrijven met formules en x,t- en v,t-diagrammen.",
      "requires": ["eenheden-meten", "vergelijkingen"],
      "recommends": ["functies", "afgeleiden"]
    },
    {
      "key": "krachten-newton",
      "name": "Krachten en de wetten van Newton",
      "description": "Je kunt krachten als vectoren optellen en met de drie wetten van Newton de versnelling van een voorwerp bepalen.",
      "requires": ["kinematica", "algebra-basis", "vectoren"],
      "recommends": []
    },
    {
      "key": "energie-arbeid",
      "name": "Arbeid en energie",
      "description": "Je kunt arbeid, kinetische en potentiële energie berekenen en behoud van energie gebruiken. Met integralen reken je ook met krachten die niet constant zijn.",
      "requires": ["krachten-newton"],
      "recommends": ["integralen"]
    },
    {
      "key": "impuls",
      "name": "Impuls en botsingen",
      "description": "Je kunt impuls en impulsbehoud gebruiken om elastische en inelastische botsingen door te rekenen.",
      "requires": ["krachten-newton"],
      "recommends": ["energie-arbeid"]
    },
    {
      "key": "cirkelbeweging",
      "name": "Cirkelbeweging",
      "description": "Je kunt hoeksnelheid, periode en middelpuntzoekende kracht berekenen voor een voorwerp dat een cirkel beschrijft.",
      "requires": ["krachten-newton", "trigonometrie"],
      "recommends": []
    },
    {
      "key": "rotatie",
      "name": "Rotatie en koppel",
      "description": "Je kunt koppel, traagheidsmoment en draaiimpuls gebruiken om het draaien van een star voorwerp te beschrijven.",
      "requires": ["krachten-newton", "vectoren"],
      "recommends": ["cirkelbeweging"]
    },
    {
      "key": "gravitatie",
      "name": "Gravitatie",
      "description": "Je kunt de gravitatiewet van Newton toepassen op planeten en satellieten en banen en ontsnappingssnelheid berekenen.",
      "requires": ["krachten-newton", "cirkelbeweging"],
      "recommends": ["energie-arbeid"]
    },
    {
      "key": "trillingen-golven",
      "name": "Trillingen en golven",
      "description": "Je kunt trillingen en golven beschrijven met amplitude, frequentie, golflengte en snelheid, en interferentie en staande golven verklaren.",
      "requires": ["functies", "trigonometrie"],
      "recommends": ["krachten-newton"]
    },
    {
      "key": "elektriciteit",
      "name": "Elektriciteit",
      "description": "Je kunt spanning, stroom, weerstand en vermogen berekenen in eenvoudige schakelingen en de wet van Coulomb toepassen.",
      "requires": ["vergelijkingen", "eenheden-meten"],
      "recommends": ["krachten-newton", "energie-arbeid"]
    },
    {
      "key": "magnetisme",
      "name": "Magnetisme",
      "description": "Je kunt magnetische velden en de kracht op een lading of stroomdraad beschrijven en inductie kwalitatief verklaren.",
      "requires": ["elektriciteit", "vectoren"],
      "recommends": ["cirkelbeweging"]
    },
    {
      "key": "thermodynamica",
      "name": "Warmte en thermodynamica",
      "description": "Je kunt temperatuur, warmte, soortelijke warmte en de gaswetten gebruiken en de hoofdwetten van de thermodynamica noemen.",
      "requires": ["energie-arbeid", "eenheden-meten"],
      "recommends": ["kans-statistiek", "exponenten-logaritmen"]
    },
    {
      "key": "optica",
      "name": "Optica",
      "description": "Je kunt breking, terugkaatsing en beeldvorming met lenzen en spiegels uitrekenen met stralengang en de lenzenformule.",
      "requires": ["trillingen-golven", "meetkunde", "trigonometrie"],
      "recommends": []
    },
    {
      "key": "quantum-intro",
      "name": "Inleiding quantummechanica",
      "description": "Je kunt het foto-elektrisch effect, golf-deeltjedualiteit en energieniveaus in atomen beschrijven.",
      "requires": ["trillingen-golven", "energie-arbeid"],
      "recommends": ["kans-statistiek", "lineaire-algebra", "magnetisme"]
    },
    {
      "key": "relativiteit-intro",
      "name": "Inleiding relativiteitstheorie",
      "description": "Je kunt tijdsdilatatie, lengtecontractie en de relatie tussen massa en energie uitleggen en eenvoudig doorrekenen.",
      "requires": ["kinematica", "energie-arbeid", "vergelijkingen"],
      "recommends": ["vectoren", "magnetisme"]
    }
  ],
